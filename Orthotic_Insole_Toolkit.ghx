                            <item name="Description" type_name="gh_string" type_code="10">Export-ready NURBS solid for CNC or 3D print</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">3f257759-2ade-4966-a627-e168303bd888</item>
                            <item name="Name" type_name="gh_string" type_code="10">export_brep</item>
