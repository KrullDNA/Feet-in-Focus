                <chunk name="Container">
                  <items count="8">
                    <item name="Description" type_name="gh_string" type_code="10">A panel for displaying data.</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">fe4b1311-c08e-4169-9d60-6488f43b21c4</item>
                    <item name="Locked" type_name="gh_bool" type_code="1">false</item>
                    <item name="Name" type_name="gh_string" type_code="10">Panel</item>
