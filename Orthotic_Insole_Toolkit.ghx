                        <chunk name="param" index="1">
                          <items count="7">
                            <item name="Description" type_name="gh_string" type_code="10">Rearfoot medial post degrees</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">a720cc25-1ff6-4274-a8ab-230fa84c5724</item>
                            <item name="Name" type_name="gh_string" type_code="10">rf_med_deg</item>
                            <item name="NickName" type_name="gh_string" type_code="10">RFM</item>
                            <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                            <item name="SourceCount" type_name="gh_int32" type_code="3">1</item>
                            <item name="Source" type_name="gh_guid" type_code="9" index="0">23e6d390-76aa-4322-aa40-3960cfe7ac78</item>
                          </items>
                        </chunk>
                        <chunk name="param" index="2">
