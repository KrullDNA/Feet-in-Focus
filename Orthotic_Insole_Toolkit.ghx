                    <item name="NickName" type_name="gh_string" type_code="10">Instructions</item>
                    <item name="Description" type_name="gh_string" type_code="10">A panel for displaying data.</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">2bb55e55-6ff8-4158-9e68-be430af1a027</item>
                    <item name="Preview" type_name="gh_bool" type_code="1">true</item>
