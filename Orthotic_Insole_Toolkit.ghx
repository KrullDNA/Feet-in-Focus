                    <item name="Description" type_name="gh_string" type_code="10">A panel for displaying data.</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">f784a01d-d991-4a4d-95df-227c46dc59af</item>
                    <item name="Preview" type_name="gh_bool" type_code="1">true</item>
