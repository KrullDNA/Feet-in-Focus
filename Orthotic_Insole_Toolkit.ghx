                        <chunk name="param" index="0">
                          <items count="5">
                            <item name="Description" type_name="gh_string" type_code="10">Rearfoot wedge brep</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">d2ac82f8-bac6-43d0-b523-da541413a240</item>
                            <item name="Name" type_name="gh_string" type_code="10">rf_post_brep</item>
