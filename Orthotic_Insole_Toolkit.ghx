                  </items>
                  <chunks count="3">
                    <chunk name="param_input">
                      <items count="1">
                        <item name="param_count" type_name="gh_int32" type_code="3">4</item>
                      </items>
                      <chunks count="4">
                        <chunk name="param" index="0">
                          <items count="5">
                            <item name="Description" type_name="gh_string" type_code="10">From 02</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">35e3a582-88ba-4264-9cbf-6f7232134fc0</item>
                            <item name="Name" type_name="gh_string" type_code="10">insole_outline</item>
