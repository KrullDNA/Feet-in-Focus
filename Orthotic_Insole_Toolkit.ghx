                      <chunks count="5">
                        <chunk name="param" index="0">
                          <items count="6">
                            <item name="Description" type_name="gh_string" type_code="10">From 02</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">ba1a96a2-6f58-4316-915c-f9f65ff07b9b</item>
                            <item name="Name" type_name="gh_string" type_code="10">insole_outline</item>
                            <item name="NickName" type_name="gh_string" type_code="10">Outl</item>
                            <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                            <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                          </items>
                        </chunk>
                        <chunk name="param" index="1">
                          <items count="7">
                            <item name="Description" type_name="gh_string" type_code="10">Dome height mm</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">82d320b4-8f12-4311-9bfb-c0f6f57da92e</item>
                            <item name="Name" type_name="gh_string" type_code="10">dome_height</item>
