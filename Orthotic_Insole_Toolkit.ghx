                    <item name="MarshalOutGuids" type_name="gh_bool" type_code="1">false</item>
                    <item name="Name" type_name="gh_string" type_code="10">06 Posting / Wedging</item>
                    <item name="NickName" type_name="gh_string" type_code="10">06 Posting</item>
                  </items>
                  <chunks count="3">
                    <chunk name="param_input">
                      <items count="1">
                        <item name="param_count" type_name="gh_int32" type_code="3">5</item>
                      </items>
                      <chunks count="5">
                        <chunk name="param" index="0">
                          <items count="6">
                            <item name="Description" type_name="gh_string" type_code="10">From 02</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">2a743d7c-d779-4612-baf5-8340ad114e75</item>
                            <item name="Name" type_name="gh_string" type_code="10">insole_outline</item>
                            <item name="NickName" type_name="gh_string" type_code="10">Outl</item>
